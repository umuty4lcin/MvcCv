@using MvcCv.Models.Entity;
@model List<TblAdmin>
@{ ViewBag.Title = "Admin"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<br />
<h2>Adminler</h2>

<table class="table table-bordered">
    <tr>
        <td>ID</td>
        <td>Kullanıcı Adı</td>
        <td>Şifre</td>
        <td>Düzenle</td>
        <td>Sil</td>
    </tr>

    @foreach(var item in Model){
        <tr>
            <td>@item.Id</td>
            <td>@item.KullaniciAdi</td>

            <td>@item.Sifre</td>

            <td><a href="/Admin/AdminGetir/@item.Id" class="btn btn-success">Düzenle</a></td>
            <td><a href="/Admin/AdminSil/@item.Id" class="btn btn-danger">Sil</a></td>

        </tr>
    }
</table>
<a href="/Admin/AdminEkle/" class="btn btn-primary">Yeni Admin Ekle</a>
