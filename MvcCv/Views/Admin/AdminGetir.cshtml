@model MvcCv.Models.Entity.TblAdmin
@{
    ViewBag.Title = "Admin Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Admin Düzenleme Sayfası</h4>
<br />

      @if (ViewBag.Hata != null)
      {
          <div class="alert alert-danger">@ViewBag.Hata</div>
      }

<form method="post">
    @Html.Label("Admin Id")

    @Html.TextBoxFor(x => x.Id, new { @class = "form-control", @readonly = "readonly" })
    <br />
    @Html.Label("Kullanıcı Adı")
    @Html.TextBoxFor(x => x.KullaniciAdi, new { @class = "form-control" })
    <br />
    @Html.Label("Şifre")
    @Html.TextBoxFor(x => x.Sifre, new { @class = "form-control" })
    <br />

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>
