@model MvcCv.Models.Entity.TblSosyalMedya
@{
    ViewBag.Title = "Sosyal Medya Güncelle"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2>Sosyal Medya Güncelle</h2>

<form method="post">

    @Html.Label("Sosyal Medya Id")
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control", @readonly = "readonly" })
    <br />
    @Html.Label("Sosyal Medya")
    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
    <br />
    @Html.Label("Link")
    @Html.TextBoxFor(x => x.Link, new { @class = "form-control" })
    <br />

    <button class="btn btn-info">Güncelle</button>

</form>
