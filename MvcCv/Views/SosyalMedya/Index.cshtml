@using MvcCv.Models.Entity;
@model List<TblSosyalMedya>
@{
    ViewBag.Title = "Sosyal Medya"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Sosyal Medya Hesap Listem</h3>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <button class="btn-info" data-toggle="modal" data-target="#modal1">Yeni Hesap Ekle</button>
                                <br />
                                <br />
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>Sosyal Medya</th>
                                            <th>Link</th>
                                            <th>Durum</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.Id</td>
                                                <td>@item.Ad</td>
                                                <td>@item.Link</td>

                                                @if (@item.Durum == true)
                                                {
                                                    <td>Aktif</td>
                                                }
                                                @if (@item.Durum == false)
                                                {
                                                    <td>Pasif</td>
                                                }
                                                <td>
                                                    <a class="btn btn-info btn-sm" href="/SosyalMedya/Guncelle/@item.Id">

                                                        <i class="fas fa-pencil-alt">Düzenle</i>
                                                    </a>

                                                    <a class="btn btn-danger btn-sm" href="/SosyalMedya/Sil/@item.Id">
                                                        <i class="fas fa-trash">Sil</i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.card -->
                    </div>
                </div>
            </div><!-- /.container-fluid -->
        </section>
        <!-- /.content -->

<div class="modal fade" id="modal1" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Sosyal Medya Hesabı Ekleme</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form method="post" action="/SosyalMedya/Ekle">
                <div class="modal-body">
                    <label>Sosyal Medya İsmi (ikon)</label>
                    <input type="text" name="Ad" class="form-control" placeholder="github" />
                    <br />
                    <label>Link</label>
                    <input type="text" name="Link" class="form-control" placeholder="https://github.com/..." />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
