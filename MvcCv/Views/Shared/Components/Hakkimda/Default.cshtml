@model List<MvcCv.Models.Entity.TblHakkimda>

<div class="resume-section-content">
    @foreach (var x in Model)
    {
        <h1 class="mb-0">
            @x.Ad
            <span class="text-primary">@x.Soyad</span>
        </h1>
        <div class="subheading mb-5">
            @x.Adres · @x.Telefon ·
            <a href="mailto:@x.Mail">@x.Mail</a>
        </div>
        <p class="lead mb-5">@x.Açıklama</p>

         @await Component.InvokeAsync("SosyalMedya")
    }
</div>
