@model MvcCv.Models.Entity.TblDeneyimlerim
@{
    ViewBag.Title = "Deneyim Güncelle"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Deneyim Düzenleme Sayfası</h4>
<br />

<form method="post">

    @Html.Label("Deneyim Id")

    @Html.TextBoxFor(x => x.Id, new { @class = "form-control", @readonly = "readonly" })
    <br />
    @Html.Label("Başlık")
    @Html.TextBoxFor(x => x.Baslik, new { @class = "form-control" })
    <br />
    @Html.Label("Alt Başlık")
    @Html.TextBoxFor(x => x.AltBaslik, new { @class = "form-control" })
    <br />
    @Html.Label("Tarih")
    @Html.TextBoxFor(x => x.Tarih, new { @class = "form-control" })
    <br />
    @Html.Label("Açıklama")
    @Html.TextAreaFor(x => x.Aciklama, new { @class = "form-control", rows = 5 })
    <br/>

    <button class="btn btn-info">Güncelle</button>

</form>
